# Notion Configuration
NOTION_TOKEN=your_notion_integration_token_here

# Database IDs (get from Notion database URLs)
NOTION_DB_OBJECTIVES=your_objectives_database_id
NOTION_DB_PROJECTS=your_projects_database_id
NOTION_DB_WEEKLY_OUTCOMES=your_weekly_outcomes_database_id
NOTION_DB_DAILY_MITS=your_daily_mits_database_id

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Timezone for daily planning
TIMEZONE=UTC
